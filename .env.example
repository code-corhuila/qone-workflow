# Names only; values live in qone-infra/.env (never versioned). Everything the workflow reads.
REDIS_URL=redis://redis:6379/0
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# The workflow's own token (role SERVICE, sub qone-workflow): issued by identity (ID-07) or by dev-keys.sh
SERVICE_TOKEN=
BILLING_API_URL=http://qone-billing-api:8000
ENROLLMENT_API_URL=http://qone-enrollment-api:8000
CATALOG_API_URL=http://qone-catalog-api:8000
PORT=8000
LOG_LEVEL=info
